{
  "name": "pi-cyber-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lean offense-only engagement context extension for Pi",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "doctor": "bun src/doctor.ts",
    "install:packages": "bun scripts/install-packages.ts",
    "pi": "bash ./scripts/pi.sh",
    "pi:ast": "bash ./scripts/pi.sh --ast",
    "packages": "bun scripts/install-packages.ts",
    "packages:check": "bun scripts/install-packages.ts --check"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./config/cyber/skills"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.27",
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@ast-grep/napi": "0.51.0"
  },
  "dependencies": {
    "bigpowers": "2.88.9",
    "pi-btw": "0.8.0",
    "pi-subagents": "0.79.2",
    "pi-web-access": "0.43.0"
  }
}
